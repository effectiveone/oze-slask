---
const year = new Date().getFullYear();
---
<footer style="background:var(--surface);border-top:1px solid var(--border);margin-top:4rem;padding:2.5rem 0 1.5rem;">
  <div class="container">
    <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:2rem;margin-bottom:1.5rem;">
      <div>
        <p style="font-family:'Roboto Mono',monospace;color:var(--blue);font-size:1.1rem;margin-bottom:0.75rem;">// OZE_SLASK.init()</p>
        <p style="font-size:0.88rem;color:var(--text-muted);line-height:1.7;">Niezależny portal informacyjny o transformacji energetycznej na Śląsku. Dane, analizy, aktualności.</p>
      </div>
      <div>
        <p style="font-family:'Roboto Mono',monospace;font-size:0.7rem;color:var(--text-muted);letter-spacing:0.08em;margin-bottom:0.6rem;">NAV[]</p>
        <a href="/" style="display:block;color:var(--text-muted);font-size:0.88rem;margin-bottom:0.4rem;font-family:'Roboto Mono',monospace;">./index</a>
        <a href="/blog" style="display:block;color:var(--text-muted);font-size:0.88rem;font-family:'Roboto Mono',monospace;">./blog</a>
      </div>
      <div>
        <p style="font-family:'Roboto Mono',monospace;font-size:0.7rem;color:var(--text-muted);letter-spacing:0.08em;margin-bottom:0.6rem;">EXTERNAL[]</p>
        <a href="https://ecoaudyt.app" target="_blank" style="color:var(--accent);font-weight:600;font-family:'Roboto Mono',monospace;font-size:0.85rem;">ecoaudyt.app ↗</a>
      </div>
    </div>
    <div style="border-top:1px solid var(--border);padding-top:1rem;text-align:center;">
      <p style="font-family:'Roboto Mono',monospace;font-size:0.75rem;color:var(--text-muted);">© {year} OZE Śląsk · all rights reserved</p>
    </div>
  </div>
</footer>
