---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const dateStr = new Date(frontmatter.pubDate).toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout title={frontmatter.title} description={frontmatter.description}>
  <div class="container" style="padding:2rem 1.5rem 4rem;">
    <div style="max-width:800px;">
      <div style="font-family:'Roboto Mono',monospace;font-size:0.75rem;color:var(--text-muted);margin-bottom:0.75rem;">
        {frontmatter.tags?.join(' | ')} — {dateStr} — {frontmatter.author}
      </div>
      <h1 style="font-size:clamp(1.6rem,4vw,2.5rem);color:var(--blue);margin-bottom:0.75rem;line-height:1.2;">{frontmatter.title}</h1>
      <p style="font-family:'Roboto Mono',monospace;font-size:0.9rem;color:var(--text-muted);border-left:3px solid var(--blue);padding-left:1rem;margin-bottom:2rem;">{frontmatter.description}</p>
      <hr style="border:none;border-top:1px solid var(--border);margin-bottom:2rem;"/>
      <div class="dark-article"><slot /></div>
    </div>
  </div>
</Layout>
<style>
.dark-article :global(h2) { color:var(--blue);font-size:1.35rem;margin:2rem 0 0.75rem;font-family:'Roboto Mono',monospace; }
.dark-article :global(p) { margin-bottom:1.25rem;line-height:1.8;color:var(--text); }
.dark-article :global(a) { color:var(--accent);border-bottom:1px dashed var(--accent); }
</style>
